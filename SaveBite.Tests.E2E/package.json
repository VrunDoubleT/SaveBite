{
  "name": "savebite-tests-e2e",
  "version": "1.0.0",
  "description": "System & E2E Testing suite for SaveBite using Playwright",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:ghost": "playwright test --project=ghost --workers=1",
    "test:login": "playwright test tests/auth/01-login.spec.ts --project=ghost --workers=1",
    "test:auth": "playwright test tests/auth --project=chromium --workers=1",
    "test:auth:ghost": "playwright test tests/auth --project=ghost --workers=1",
    "test:profile": "playwright test tests/profile --project=chromium --workers=1",
    "test:profile:ghost": "playwright test tests/profile --project=ghost --workers=1",
    "test:discovery": "playwright test tests/discovery --project=chromium --workers=1",
    "test:discovery:ghost": "playwright test tests/discovery --project=ghost --workers=1",
    "test:realtime": "playwright test tests/realtime --project=chromium --workers=1",
    "test:realtime:demo": "playwright test tests/realtime --project=ghost --workers=1",
    "test:debug": "playwright test --debug",
    "test:codegen": "playwright codegen http://localhost:5173",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^22.7.5",
    "dotenv": "^16.4.5",
    "typescript": "^5.6.3"
  }
}
