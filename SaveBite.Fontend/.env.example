# Set true to run a development-only frontend mock backend.
# Production builds always use the real backend, even if this flag is true.
VITE_USE_MOCK=false
VITE_API_URL=/api
# Optional: show only the UI component reference without enabling the backend mock.
VITE_ENABLE_MOCK=false
VITE_VIETMAP_API_KEY=your_vietmap_tile_key
VITE_VIETMAP_SERVICES_KEY=your_vietmap_services_key
