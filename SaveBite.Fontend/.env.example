# Real backend URL. Set this to the API address for your local environment.
VITE_API_URL=/api
# Optional development-only component reference; does not replace backend requests.
VITE_ENABLE_UI_SHOWCASE=false
VITE_VIETMAP_API_KEY=your_vietmap_tile_key
VITE_VIETMAP_SERVICES_KEY=your_vietmap_services_key
